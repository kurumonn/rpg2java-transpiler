* free format with stub operations

EVAL ORDER_ID = 5001
EVAL CUSTOMER_ID = 1001
EVAL ORDER_STATUS = 'NEW'
EVAL ORDER_OUTPUT = 0

CHAIN CUSTOMER_ID CUSTOMER_FILE

IF ORDER_STATUS = 'NEW'
  EVAL ORDER_STATUS = 'PROCESSING'
ELSE
  EVAL ORDER_STATUS = 'SKIP'
ENDIF

SETLL ORDER_ID ORDER_FILE
READE ORDER_ID ORDER_FILE

EXSR CALC_TOTAL

EVAL AMOUNT = 12000
EVAL TAX = 1200
EVAL TOTAL = AMOUNT + TAX

WRITE ORDER_OUTPUT
CALLP PRINT_ORDER
