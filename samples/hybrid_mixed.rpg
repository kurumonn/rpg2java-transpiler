* hybrid style sample

000100C     CUSTOMER_ID   CHAIN     CUSTOMER_FILE
000200C                   EVAL      1001          CUSTOMER_ID
000300C                   EVAL      0             ORDER_OUTPUT

EVAL ORDER_ID = 5001
EVAL ORDER_STATUS = 'NEW'

CHAIN CUSTOMER_ID CUSTOMER_FILE

000400C                   IF        CUSTOMER_ID
EVAL MESSAGE = 'CUSTOMER FOUND'
000500C                   ELSE
EVAL MESSAGE = 'CUSTOMER NOT FOUND'
000600C                   ENDIF

SETLL ORDER_ID ORDER_FILE
READE ORDER_ID ORDER_FILE

EXSR CALC_TOTAL
CALLP SEND_NOTICE
WRITE ORDER_OUTPUT
