* business order flow sample

EVAL COMPANY_CODE = '001'
EVAL ORDER_ID = 900001
EVAL CUSTOMER_ID = 1001
EVAL CUSTOMER_NAME = 'KURUMON'
EVAL ORDER_STATUS = 'NEW'
EVAL ITEM_COUNT = 3
EVAL UNIT_PRICE = 2500
EVAL SUBTOTAL = ITEM_COUNT * UNIT_PRICE
EVAL TAX_RATE = 0.10
EVAL TAX = SUBTOTAL * TAX_RATE
EVAL TOTAL = SUBTOTAL + TAX
EVAL CUSTOMER_MASTER = 0
EVAL ORDER_FILE = 0
EVAL ORDER_OUTPUT = 0
EVAL ERROR_OUTPUT = 0

CHAIN CUSTOMER_ID CUSTOMER_MASTER

IF CUSTOMER_ID > 0
  EVAL CUSTOMER_FOUND = *ON
ELSE
  EVAL CUSTOMER_FOUND = *OFF
ENDIF

IF CUSTOMER_FOUND
  SETLL ORDER_ID ORDER_FILE
  READE ORDER_ID ORDER_FILE

  IF TOTAL > 10000
    EVAL ORDER_RANK = 'A'
  ELSE
    EVAL ORDER_RANK = 'B'
  ENDIF

  EXSR VALIDATE_ORDER
  EXSR CALC_DISCOUNT
  EXSR CREATE_SHIPMENT

  WRITE ORDER_OUTPUT
  CALLP SEND_ORDER_MAIL
ELSE
  EVAL ERROR_MESSAGE = 'CUSTOMER NOT FOUND'
  WRITE ERROR_OUTPUT
ENDIF

DOU TOTAL > 20000
  EVAL TOTAL = TOTAL + 1000
ENDDO

CALLP PRINT_SUMMARY
