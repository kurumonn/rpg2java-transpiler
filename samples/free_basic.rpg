* free format basic sample

EVAL CUSTOMER_ID = 1001
EVAL CUSTOMER_NAME = 'KURUMON'
EVAL AMOUNT = 15000
EVAL TAX = 1500
EVAL TOTAL = AMOUNT + TAX
EVAL CUSTOMER_FILE = 0
EVAL OUTPUT_FILE = 0

IF TOTAL > 10000
  EVAL STATUS = 'HIGH'
ELSE
  EVAL STATUS = 'NORMAL'
ENDIF

DOU TOTAL > 20000
  EVAL TOTAL = TOTAL + 1000
ENDDO

CALLP SEND_NOTICE

READ CUSTOMER_FILE
WRITE OUTPUT_FILE
